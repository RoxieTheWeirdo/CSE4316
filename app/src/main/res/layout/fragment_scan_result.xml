<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanResultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context="com.example.nutritionalappplanner.page.ScanResultFragment">

    <!-- Captured photo preview -->

    <!-- Loading spinner (hidden by default) -->
    <ImageView
        android:id="@+id/capturedImageView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:background="#EEE"
        android:contentDescription="Scanned meal photo"
        android:scaleType="centerCrop" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Detected food name -->
    <TextView
        android:id="@+id/detectedFoodName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detected Food"
        android:textSize="18sp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textStyle="bold" />

    <!-- RecyclerView to display detected foods -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/foodRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_food" />

</LinearLayout>
