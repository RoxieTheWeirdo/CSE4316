<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvPantryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pantry"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Segmented Filter -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#111318"
        app:strokeColor="#2A2D36"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvPantryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- ALL -->
            <LinearLayout
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineAll"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="#A970FF"/>
            </LinearLayout>

            <!-- FRIDGE -->
            <LinearLayout
                android:id="@+id/tabFridge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvFridge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRIDGE"
                    android:textColor="#9AA0A6" />

                <View
                    android:id="@+id/underlineFridge"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="#A970FF"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- FREEZER -->
            <LinearLayout
                android:id="@+id/tabFreezer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvFreezer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FREEZER"
                    android:textColor="#9AA0A6" />

                <View
                    android:id="@+id/underlineFreezer"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="#A970FF"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- PANTRY -->
            <LinearLayout
                android:id="@+id/tabPantry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvPantry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PANTRY"
                    android:textColor="#9AA0A6" />

                <View
                    android:id="@+id/underlinePantry"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="#A970FF"
                    android:visibility="invisible"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Row -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:background="#000000"
        android:elevation="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:hint="Search food"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:background="@drawable/search_bar_bg"
            android:paddingStart="12dp"
            android:textColor="@android:color/white"
            android:textColorHint="#9AA0A6"
            android:drawablePadding="8dp"/>

        <ImageButton
            android:id="@+id/scanButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_camera"
            android:background="@drawable/search_bar_bg"
            app:tint="@color/purple_500"
            android:scaleType="centerInside"
            android:padding="12dp"/>
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Empty -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No items yet."
        android:textColor="#9AA0A6"
        android:visibility="gone"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/searchRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPantry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"

        app:layout_constraintTop_toBottomOf="@id/searchRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>


