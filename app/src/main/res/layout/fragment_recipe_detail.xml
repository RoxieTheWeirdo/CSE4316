<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- 🔥 TOP TOOLBAR (CHECKMARK WILL APPEAR HERE) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Recipe"
        android:background="#000000"
        app:titleTextColor="@android:color/white"/>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title -->
            <TextView
                android:id="@+id/tvRecipeTitle"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Match Badge -->
            <TextView
                android:id="@+id/tvRecipeMatch"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_match_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- TABS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#111318"
                app:strokeColor="#2A2D36"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <!-- INGREDIENTS TAB -->
                    <LinearLayout
                        android:id="@+id/tabIngredients"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvIngredientsTab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INGREDIENTS"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/underlineIngredients"
                            android:layout_width="40dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:background="#A970FF" />
                    </LinearLayout>

                    <!-- INSTRUCTIONS TAB -->
                    <LinearLayout
                        android:id="@+id/tabInstructions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="6dp">

                        <TextView
                            android:id="@+id/tvInstructionsTab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INSTRUCTIONS"
                            android:textColor="#9AA0A6" />

                        <View
                            android:id="@+id/underlineInstructions"
                            android:layout_width="40dp"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:background="#A970FF"
                            android:visibility="invisible" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- INGREDIENTS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#111318"
                app:strokeColor="#2A2D36"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/layoutIngredients"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Ingredients"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- INSTRUCTIONS -->
            <LinearLayout
                android:id="@+id/layoutInstructions"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#111318"
                    app:strokeColor="#2A2D36"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Instructions"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tvInstructions"
                            android:textColor="#E0E0E0"
                            android:lineSpacingExtra="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
